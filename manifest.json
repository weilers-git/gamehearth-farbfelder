{
  "id": "farbfelder",
  "name": "Farbfelder",
  "version": "0.1.0",
  "description": "Lauf mit dem Handy übers Feld, färb Kästchen in deiner Farbe und kleckse; nach 90 Sekunden gewinnt, wer die meisten hat",
  "repository": "https://github.com/weilers-git/gamehearth-farbfelder",
  "sdk": "^0.1.1",
  "license": {
    "code": "MIT",
    "assets": "CC0-1.0"
  },
  "mode": "realtime",
  "players": {
    "min": 2,
    "max": 8
  },
  "server": true,
  "client": "dist/client",
  "roles": {
    "screen": {
      "inputs": [],
      "screen": "large"
    },
    "controller": {
      "inputs": [
        "touch",
        "keyboard"
      ],
      "screen": "small"
    }
  }
}
