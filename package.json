{
  "name": "farbfelder",
  "version": "0.2.0",
  "private": true,
  "description": "Farbfelder: Partyspiel für Gamehearth, in dem alle mit dem Handy Kästchen in ihrer Farbe einfärben",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "gamehearth dev . --build \"npm run build:watch\" --client dist/dev-client",
    "build": "vite build --config client/vite.config.ts --logLevel warn",
    "build:watch": "vite build --config client/vite.config.ts --logLevel warn --watch --sourcemap --outDir ../dist/dev-client",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p client/tsconfig.json",
    "check": "npm run build && gamehearth check .",
    "pack": "npm run build && gamehearth pack ."
  },
  "dependencies": {
    "@gamehearth/sdk": "file:vendor/gamehearth-sdk-0.1.3.tgz",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "gamehearth": "file:vendor/gamehearth-0.5.0.tgz",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@gamehearth/sdk": "$@gamehearth/sdk"
  }
}
